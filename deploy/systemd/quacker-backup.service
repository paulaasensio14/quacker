[Unit]
Description=Backup periódico de la base de datos de Quacker
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/quacker/server
UMask=0077
ExecStart=/usr/bin/node /home/ubuntu/apps/quacker/server/scripts/backup-db.js --directory /var/backups/quacker --limit 30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/quacker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
